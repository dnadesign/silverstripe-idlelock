{
    "name": "dnadesign/silverstripe-idlelock",
    "description": "Idle accounts are the security vulnerability's gateway",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "account management",
        "cms",
        "security",
        "silverstripe"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.4",
        "silverstripe/framework": "^6",
        "silverstripe/reports": "^6",
        "silverstripe/siteconfig": "^6"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2.1",
        "cambis/silverstan": "^2.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6",
        "wernerkrauss/silverstripe-rector": "^1.3",
        "slevomat/coding-standard": "^8.31",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "symplify/easy-coding-standard": "^13.3",
        "silverstripe/standards": "^1.2"
    },
    "suggest": {
        "silverstripe/silverstripe-crontask": "Simplify working with crons by setting up a single generic cronjob on the server side, and delegating the actual job definition to the PHP code."
    },
    "autoload": {
        "psr-4": {
            "DNADesign\\IdleLock\\": "src/",
            "DNADesign\\IdleLock\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpstan/extension-installer": true,
            "silverstripe/vendor-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
      "lint": [
        "vendor/bin/parallel-lint src tests --colors --blame",
        "vendor/bin/ecs check --ansi",
        "vendor/bin/phpstan analyse --ansi --memory-limit=-1"
      ],
      "lint:fix": [
        "vendor/bin/ecs check --fix --ansi"
      ]
    }
}
